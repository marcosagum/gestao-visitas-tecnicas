# Pooled connection (port 6543) — used by the app at runtime and by most Prisma CLI commands.
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
# Direct connection (port 5432, no pooler) — required by `prisma migrate dev` for shadow-database creation.
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"
